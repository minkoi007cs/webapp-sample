{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["icn1"],
  "functions": {
    "api/index.ts": {
      "includeFiles": "server/{dist/**,src/i18n/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/|api$|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
